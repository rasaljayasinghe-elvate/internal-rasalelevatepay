# Neon Postgres connection string
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# NextAuth (Auth.js v5)
AUTH_SECRET="generate with: npx auth secret"
# Shared login password for all allowed @company emails (swap for Google OAuth later if needed)
AUTH_PASSWORD="change-me-in-production"
ALLOWED_EMAIL_DOMAIN="your-company.com"
# Legacy name still supported:
# ALLOWED_GOOGLE_DOMAIN="your-company.com"
# Comma-separated list of operator emails (everyone else who signs in is a reader)
OPERATOR_EMAILS="you@your-company.com"

# Extraction provider: "claude" or "grok"
EXTRACT_PROVIDER="claude"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
XAI_API_KEY=""
XAI_MODEL="grok-4"
