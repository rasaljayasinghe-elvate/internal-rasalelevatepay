# Neon Postgres connection string
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Extraction provider: "claude" or "grok"
EXTRACT_PROVIDER="claude"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
XAI_API_KEY=""
XAI_MODEL="grok-4"

# Metricool brand analytics. Token: Account settings → API. userId and blogId
# are in the brand URL. API access requires the Advanced plan. blogId can also
# be set per campaign in the app.
METRICOOL_TOKEN=""
METRICOOL_USER_ID=""
METRICOOL_BLOG_ID=""
