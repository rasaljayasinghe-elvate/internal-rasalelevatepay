# Neon Postgres connection string
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# NextAuth
AUTH_SECRET="generate with: npx auth secret"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
ALLOWED_GOOGLE_DOMAIN="elevatepay.com"
# Comma-separated list of operator emails (everyone else who signs in is a reader)
OPERATOR_EMAILS="rasal@elevatepay.com"

# Extraction provider: "claude" or "grok"
EXTRACT_PROVIDER="claude"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
XAI_API_KEY=""
XAI_MODEL="grok-4"
